# Gerenciado pelo Ansible (role containers) — não editar manualmente na VM.
# Serve o frontend React e encaminha as chamadas /todos para a API (contêiner todo-backend).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API: /todos e /todos/:id -> contêiner da API na rede interna do Docker
    location /todos {
        proxy_pass http://todo-backend:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend React (single page application)
    location / {
        try_files $uri $uri/ /index.html;
    }
}